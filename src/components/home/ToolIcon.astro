---
interface Props {
  tool: string;
}
const { tool } = Astro.props;
---

<svg viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {
    tool === 'toolbox' && (
      <>
        <rect x="2.5" y="4" width="19" height="16" rx="3" />
        <path d="m7 9.5 3 2.5-3 2.5M12.5 15H17" />
      </>
    )
  }
  {
    tool === 'boot' && (
      <>
        <rect x="6.5" y="9" width="11" height="13" rx="2.5" />
        <path d="M9 9V2.5h6V9M11 5.5v1M13 5.5v1" />
      </>
    )
  }
  {
    tool === 'webos-launcher' && (
      <>
        <rect x="2.5" y="6" width="19" height="13" rx="2.5" />
        <path d="m8 2 4 4 4-4M8 22h8" />
      </>
    )
  }
  {
    tool === 'touchdown' && (
      <>
        <ellipse cx="12" cy="12" rx="10" ry="6" transform="rotate(-45 12 12)" />
        <path d="M9 15l6-6M10.3 12.3l1.4 1.4M11.3 11.3l1.4 1.4M12.3 10.3l1.4 1.4" />
      </>
    )
  }
</svg>
